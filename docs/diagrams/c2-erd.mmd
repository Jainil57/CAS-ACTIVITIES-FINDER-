erDiagram
  SCHOOLS ||--o{ USERS : "has"
  SCHOOLS ||--o{ PROJECTS : "hosts"
  USERS ||--o{ PROJECTS : "creates"
  USERS ||--o{ MEMBERSHIPS : "requests"
  PROJECTS ||--o{ MEMBERSHIPS : "receives"
  USERS ||--o{ SESSIONS : "logs in with"
  SCHOOLS {
    int id PK
    varchar name UK
    varchar city
    int is_active
  }
  USERS {
    int id PK
    int school_id FK "NULL for admin"
    varchar login_id "UNIQUE with school_id"
    varchar name
    enum role "student|teacher|principal|admin"
    varchar password_hash "salt:scrypt hash"
    int is_active
  }
  PROJECTS {
    int id PK
    varchar title
    text description
    enum strand "Creativity|Activity|Service"
    int school_id FK
    int creator_id FK
    int interschool
    varchar location
    date start_date
    date end_date
    date apply_deadline
    int hours
    int fee
    int cap_participant
    int cap_volunteer
    int cap_organizer
    enum status "pending|approved|rejected|ongoing|completed"
    varchar teacher_comment
  }
  MEMBERSHIPS {
    int id PK
    int project_id FK
    int user_id FK
    enum role "participant|volunteer|organizer"
    enum status "pending|accepted|rejected"
    date requested_at
  }
  SESSIONS {
    varchar token PK
    int user_id FK
    bigint expires_at
  }
